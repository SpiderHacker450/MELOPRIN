{
  "name": "pinkverse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.cjs",
    "test:photo-security": "node scripts/test-image-security.cjs",
    "test:attacks": "node scripts/test-hardened-attacks.cjs",
    "prepare:derivatives": "node scripts/prepare-hardened-derivatives.cjs",
    "build:web": "tsc && vite build && powershell -Command \"if (-not (Test-Path 'dist/web')) { New-Item -ItemType Directory -Path 'dist/web' -Force }; Copy-Item -Path 'dist/*' -Destination 'dist/web' -Recurse -Exclude 'web' -Force\"",
    "electron:start": "electron electron/main.cjs",
    "electron:run": "node scripts/launch-electron.cjs",
    "electron:test": "node scripts/test-electron-protection.cjs",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder --win",
    "cap:sync": "npx.cmd cap sync",
    "cap:android": "npx.cmd cap open android"
  },
  "build": {
    "appId": "com.pinkverse.app",
    "productName": "PINKVERSE",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "gsap": "^3.12.7",
    "howler": "^2.2.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.3",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
